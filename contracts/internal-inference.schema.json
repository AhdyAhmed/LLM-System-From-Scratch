{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scratchllm.local/contracts/internal-inference.schema.json",
  "title": "InternalJavaToPythonInferenceContract",
  "type": "object",
  "required": [
    "schema_version",
    "run_id",
    "attempt_token",
    "model_revision",
    "prompt",
    "context_limit",
    "sampling",
    "deadline_epoch_ms"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "run_id": {
      "type": "string",
      "format": "uuid"
    },
    "attempt_token": {
      "type": "integer",
      "minimum": 1
    },
    "model_revision": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "prompt": {
      "type": "string",
      "minLength": 1,
      "maxLength": 16384
    },
    "context_limit": {
      "type": "integer",
      "enum": [128, 256, 512, 1024]
    },
    "sampling": {
      "type": "object",
      "required": ["max_new_tokens", "temperature", "top_k", "top_p"],
      "additionalProperties": false,
      "properties": {
        "max_new_tokens": {
          "type": "integer",
          "minimum": 1,
          "maximum": 64
        },
        "temperature": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 2.0
        },
        "top_k": {
          "type": "integer",
          "minimum": 1,
          "maximum": 256
        },
        "top_p": {
          "type": "number",
          "minimum": 0.05,
          "maximum": 1.0
        },
        "seed": {
          "type": ["integer", "null"]
        }
      }
    },
    "deadline_epoch_ms": {
      "type": "integer",
      "minimum": 1
    },
    "fault_injection": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "properties": {
        "chunk_delay_ms": {
          "type": "integer",
          "minimum": 0,
          "maximum": 5000
        },
        "fail_after_chunks": {
          "type": ["integer", "null"],
          "minimum": 0
        },
        "error_code": {
          "type": ["string", "null"]
        }
      }
    }
  }
}
