{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scratchllm.local/contracts/sse-events.schema.json",
  "title": "DurableSseEventEnvelope",
  "type": "object",
  "required": ["id", "event", "data"],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "integer",
      "minimum": 1
    },
    "event": {
      "type": "string",
      "enum": [
        "run.queued",
        "run.started",
        "sources",
        "text.delta",
        "run.completed",
        "run.cancelled",
        "run.failed",
        "resync.required"
      ]
    },
    "data": {
      "type": "object",
      "required": ["run_id", "schema_version"],
      "properties": {
        "run_id": {
          "type": "string",
          "format": "uuid"
        },
        "schema_version": {
          "type": "integer",
          "const": 1
        },
        "model_revision": {
          "type": "string"
        },
        "text": {
          "type": "string"
        },
        "finish_reason": {
          "type": "string",
          "enum": ["stop", "length", "cancelled", "error"]
        },
        "input_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "output_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "error_code": {
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "sources": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["chunk_id", "document_id", "title", "location"],
            "properties": {
              "chunk_id": { "type": "string", "format": "uuid" },
              "document_id": { "type": "string", "format": "uuid" },
              "title": { "type": "string" },
              "location": { "type": "string" }
            }
          }
        }
      }
    }
  }
}
