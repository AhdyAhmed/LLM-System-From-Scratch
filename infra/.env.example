# Local Development Infrastructure Configuration (Bind strictly to 127.0.0.1)
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=postgres_local_dev

# Application Database (Java Modular Monolith + Flyway + pgvector)
LLM_DB_NAME=llm_app
LLM_DB_USER=llm_app_user
LLM_DB_PASSWORD=llm_app_local_pass
LLM_DB_PORT=54322

# MLflow Tracking & Registry Metadata Database
MLFLOW_DB_NAME=mlflow_db
MLFLOW_DB_USER=mlflow_user
MLFLOW_DB_PASSWORD=mlflow_local_pass
MLFLOW_PORT=5001

# Airflow Offline Orchestration Metadata Database
AIRFLOW_DB_NAME=airflow_db
AIRFLOW_DB_USER=airflow_user
AIRFLOW_DB_PASSWORD=airflow_local_pass
AIRFLOW_PORT=8088

# Redis Session, Rate Limit & Immutable Metadata Cache
REDIS_PORT=63799

# Apache Kafka Single-Broker KRaft Local Profile
KAFKA_PORT=9094
